{
  "_comment": "sections: glob patterns matched against 'Notebook/Section', first match wins. Values: mine | private | skip. default applies when nothing matches. Build the patterns from `export_onenote_graph.py --list`.",
  "default": "mine",
  "sections": {
    "*/Finance*": "private",
    "*/Personal*": "skip",
    "Personal*/*": "skip"
  },
  "hard_patterns": {
    "card_number": "\\b(?:\\d[ -]?){13,19}\\b",
    "ssn": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
    "credential": "(?i)\\b(password|passwd|pwd|api[_ -]?key|secret|token)\\b\\s*[:=]\\s*\\S+",
    "private_key": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  },
  "soft_patterns": {
    "money": "[$€£]\\s?\\d[\\d,]*(?:\\.\\d{2})?|\\b\\d[\\d,]*\\s?(?:USD|EUR|GBP)\\b",
    "email": "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
    "phone": "\\b(?:\\+?1[ -.]?)?\\(?\\d{3}\\)?[ -.]?\\d{3}[ -.]?\\d{4}\\b"
  },
  "keywords": [
    "confidential",
    "NDA",
    "salary",
    "termination",
    "lawsuit"
  ]
}
